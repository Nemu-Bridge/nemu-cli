{
  "name": "nemu-cli",
  "version": "1.8.0",
  "description": "Command line access to Nemu, and portable project memory for Claude Code, Codex and any MCP client.",
  "bin": {
    "nemu": "./dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "plugin",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "bun test",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "nemu",
    "ai",
    "cli",
    "oauth",
    "device-flow",
    "mcp",
    "claude-code",
    "codex",
    "memory",
    "obsidian",
    "sync"
  ],
  "author": "hiraeeth",
  "license": "MIT",
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^20.0.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://docs.nemu.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nemu-Bridge/nemu-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Nemu-Bridge/nemu-cli/issues"
  },
  "dependencies": {
    "@nemu-ai/sdk": "^1.1.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "cross-spawn": "7.0.6",
    "hash-wasm": "4.12.0",
    "jsonc-parser": "3.3.1",
    "zod": "^4.1.0"
  }
}
